# Local evaluation only. Keep DEMO as the default.
APC_MODE=DEMO
APC_DB_PATH=./var/apc.db
# Set only if binding the HTTP API off localhost. Supply a random value >=32 chars.
# APC_ADMIN_TOKEN=replace-with-a-secret-of-at-least-32-characters
# Set to 1 only for the local SQLite sandbox MCP tool; not for live providers.
# APC_MCP_ENABLE_LAB=1
